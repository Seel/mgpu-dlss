diff --git a/package/F4SE/Plugins/FrameGeneration/DepthFromHalfResCS.hlsl b/package/F4SE/Plugins/FrameGeneration/DepthFromHalfResCS.hlsl
new file mode 100644
index 0000000..281acb9
--- /dev/null
+++ b/package/F4SE/Plugins/FrameGeneration/DepthFromHalfResCS.hlsl
@@ -0,0 +1,51 @@
+// FG-GPU1 (iHalfResDepthMV = 1): runs on the frame-generation GPU. Rebuilds full-resolution
+// depth from the half-resolution depth that crossed PCIe, so FSR3 still works at full
+// resolution and reads every motion vector; only its depth tests see the coarser depth.
+//
+// Smooth surfaces (floors, walls) are interpolated bilinearly. Where the four neighbouring
+// samples differ a lot - an object edge - blending would invent a depth that belongs to neither
+// surface and FSR3 would see a false edge or disocclusion there, so the pixel takes the sample
+// of its own 2x2 block instead (which already holds that block's nearest depth).
+
+Texture2D<float> HalfDepth : register(t0);
+RWTexture2D<float> FullDepth : register(u0);
+
+// FO4 depth runs 0 (near) .. 1 (far) and 1 - depth is close to proportional to 1/distance.
+// Neighbours whose 1/distance differs by more than this fraction count as an edge.
+static const float kEdgeThreshold = 0.05;
+
+[numthreads(8, 8, 1)] void main(uint3 DTid : SV_DispatchThreadID)
+{
+	uint fullWidth, fullHeight, halfWidth, halfHeight;
+	FullDepth.GetDimensions(fullWidth, fullHeight);
+	HalfDepth.GetDimensions(halfWidth, halfHeight);
+	if (DTid.x >= fullWidth || DTid.y >= fullHeight)
+		return;
+
+	const int2 last = int2(halfWidth - 1, halfHeight - 1);
+
+	// Position in half-resolution texels: full pixel 2i sits at i - 0.25, 2i + 1 at i + 0.25.
+	const float2 position = (float2(DTid.xy) + 0.5) * 0.5 - 0.5;
+	const int2 base = int2(floor(position));
+	const float2 weight = position - float2(base);
+
+	const float d00 = HalfDepth[clamp(base, int2(0, 0), last)];
+	const float d10 = HalfDepth[clamp(base + int2(1, 0), int2(0, 0), last)];
+	const float d01 = HalfDepth[clamp(base + int2(0, 1), int2(0, 0), last)];
+	const float d11 = HalfDepth[clamp(base + int2(1, 1), int2(0, 0), last)];
+
+	const float w00 = 1.0 - d00;
+	const float w10 = 1.0 - d10;
+	const float w01 = 1.0 - d01;
+	const float w11 = 1.0 - d11;
+	const float nearest = max(max(w00, w10), max(w01, w11));
+	const float farthest = min(min(w00, w10), min(w01, w11));
+
+	float depth;
+	if (nearest <= farthest * (1.0 + kEdgeThreshold))
+		depth = lerp(lerp(d00, d10, weight.x), lerp(d01, d11, weight.x), weight.y);
+	else
+		depth = HalfDepth[min(DTid.xy / 2, uint2(last))];
+
+	FullDepth[DTid.xy] = depth;
+}
diff --git a/package/F4SE/Plugins/FrameGeneration/HalfResDepthMVCS.hlsl b/package/F4SE/Plugins/FrameGeneration/HalfResDepthMVCS.hlsl
new file mode 100644
index 0000000..9533257
--- /dev/null
+++ b/package/F4SE/Plugins/FrameGeneration/HalfResDepthMVCS.hlsl
@@ -0,0 +1,72 @@
+// FG-GPU1 (iHalfResDepthMV = 1 or 2): writes the depth that crosses PCIe at half resolution,
+// and the motion vectors at half (HALF_MV=1) or full (HALF_MV=0) resolution, in the same pass
+// that fills the shared buffers. One thread per 2x2 block of the full-resolution frame, so it
+// reads exactly what the full-resolution shaders read and writes less.
+//
+//   depth          the nearest of the four samples (FO4 depth: 0 = near, 1 = far), so thin
+//                  foreground objects survive, like FSR3's own nearest-depth dilation.
+//   HALF_MV=1      the motion vector of that same nearest sample.
+//   HALF_MV=0      all four motion vectors, unchanged.
+//   ALPHA_MASK=1   the transparent-surface mask of GenerateSharedBuffersCS (the PostAlpha path);
+//   ALPHA_MASK=0   plain copy (the path without a reticle pass), t0/t1 unused.
+
+#ifndef ALPHA_MASK
+#	define ALPHA_MASK 1
+#endif
+#ifndef HALF_MV
+#	define HALF_MV 0
+#endif
+
+Texture2D<float4> InputTexturePreAlpha : register(t0);
+Texture2D<float4> InputTextureAfterAlpha : register(t1);
+Texture2D<float2> InputMotionVectors : register(t2);
+Texture2D<float> InputDepth : register(t3);
+
+RWTexture2D<float2> OutputMotionVectors : register(u0);
+RWTexture2D<float> OutputDepth : register(u1);
+
+[numthreads(8, 8, 1)] void main(uint3 DTid : SV_DispatchThreadID)
+{
+	uint width, height;
+	InputMotionVectors.GetDimensions(width, height);
+	if (DTid.x * 2 >= width || DTid.y * 2 >= height)
+		return;
+
+	// Out-of-range loads return 0, which is the nearest possible depth; clamp instead.
+	const uint2 last = uint2(width - 1, height - 1);
+
+	float nearestDepth = 2.0;
+	float2 nearestMotion = 0.0;
+
+	[unroll] for (uint i = 0; i < 4; ++i)
+	{
+		const uint2 pos = min(DTid.xy * 2 + uint2(i & 1, i >> 1), last);
+
+		float depth = InputDepth[pos];
+		float2 motion = InputMotionVectors[pos];
+
+#if ALPHA_MASK
+		float3 difference = abs(InputTexturePreAlpha[pos].xyz - InputTextureAfterAlpha[pos].xyz);
+		float mask = max(difference.x, max(difference.y, difference.z));
+		mask *= 1000.0;
+		mask = 1.0 - saturate(mask);
+
+		motion = lerp(0.0, motion, mask);
+		depth = lerp(min(depth, 0.1), depth, mask);
+#endif
+
+#if !HALF_MV
+		OutputMotionVectors[pos] = motion;
+#endif
+
+		if (depth < nearestDepth) {
+			nearestDepth = depth;
+			nearestMotion = motion;
+		}
+	}
+
+	OutputDepth[DTid.xy] = nearestDepth;
+#if HALF_MV
+	OutputMotionVectors[DTid.xy] = nearestMotion;
+#endif
+}
