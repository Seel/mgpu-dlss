diff --git a/package/MCM/Config/FrameGeneration/settings.ini b/package/MCM/Config/FrameGeneration/settings.ini
index fa75993..c0933ee 100644
--- a/package/MCM/Config/FrameGeneration/settings.ini
+++ b/package/MCM/Config/FrameGeneration/settings.ini
@@ -8,18 +8,95 @@ bFrameGenerationMode = 1
 ; Default: true
 bFrameLimitMode = 1
 
-; Disable frame generation in menus (Pip-Boy, etc.) to avoid interpolation artifacts
+; Disable frame generation in menus (Pip-Boy, etc.) to avoid interpolation artifacts (can be toggled mid-game)
 ; Default: true
 bDisableInMenus = 1
 
 ; Frame generation backend (requires game restart to change)
-; Default: 1 (0=FSR3, 1=DLSS-G, 2=XeSS-FG)
-iFrameGenType = 1
+; 0=FSR3, 1=DLSS-G, 2=XeSS-FG. Default in this package: 0. Ignored (FSR3) when bFrameGenOnSecondaryGPU = 1.
+iFrameGenType = 0
 
 ; DLSS-G frame multiplier (requires game restart, RTX 50+ for 3x/4x)
 ; Default: 0 (0=2x, 1=3x MFG, 2=4x MFG)
 iFrameGenFrames = 0
 
+; FSR runtime used for FSR frame generation (requires game restart).
+;   0 = FidelityFX SDK 1.1.4 (FSR 3.1.4), the runtime this mod was first tested with.
+;   1 = FSR SDK 2.4: the newest FSR frame generation the driver and Windows offer. On an RX 9000
+;       with Adrenalin 26.10.1+ that is the 4.0.0 swap chain (driver-assisted frame pacing when
+;       VSync is off, the game covers the display and runs inside the VRR range), plus FSR 4 ML
+;       frame generation on Windows 11 - otherwise the FSR 3.1.6 interpolator. The log lists
+;       what was offered and what is used. If 2.4 fails to start, the plugin falls back to 1.1.4.
+; Default: 1
+iFSRRuntime = 1
+
+; FSR SDK 2.4 only (requires game restart): which swap chain / interpolator to use.
+;   0 = newest offered, 1 = newest 3.x (swap chain 3.1.7 / FSR 3.1.6), for A/B comparisons.
+; Default: 0
+iFSRSwapChainProvider = 0
+iFSRFrameGenProvider = 0
+
 ; Enables verbose Streamline logging for troubleshooting. Requires game restart.
 ; Default: false
 bEnableDebugLogging = 0
+
+; [FG-GPU1] Run FSR3 frame generation and present on a SECOND GPU - the one the monitor is
+; plugged into - while the game keeps rendering on its own GPU. Every frame's colour,
+; HUD-less colour, depth and motion vectors are copied across PCIe. Requires game restart.
+; Not supported with ENB yet. Default: false
+bFrameGenOnSecondaryGPU = 1
+
+; [FG-GPU1] Optional: part of the secondary GPU's name, e.g. "9060". Leave empty to pick the
+; GPU that drives the monitor the game window is on. Requires game restart.
+sSecondaryGPUName =
+
+; [FG-GPU1] Send an EXTRA, UI-free copy of every frame to the frame-generation GPU.
+;   On  = generated frames keep a clean HUD (recommended).
+;   Off = ~25% less PCIe traffic, but the HUD is interpolated with the scene and smears
+;         during camera movement.
+; Requires restart. Default: true
+bSendHudlessFrame = 1
+
+; [FG-GPU1] How the frame-generation GPU reads the frames it receives.
+;   On  = on a copy queue, starting on each buffer as soon as it has crossed PCIe, so the
+;         two PCIe trips overlap and the FSR3 queue never waits for the read (recommended).
+;   Off = the original path: wait for the whole transfer, then read it on the FSR3 queue.
+; Requires restart. Default: true
+bAsyncUnpack = 1
+
+; [FG-GPU1] When the frame's inputs cross PCIe.
+;   On  = depth and motion vectors start crossing during the world pass, the HUD-less frame
+;         right after its capture, and only the finished frame waits for Present (recommended).
+;   Off = everything crosses at Present, as before (for A/B).
+; Read every ~60 frames, so it can be toggled while the game runs. Default: true
+bEarlyTransfer = 1
+
+; [FG-GPU1] When the frame-generation GPU READS what has crossed (needs bAsyncUnpack and
+; bEarlyTransfer).
+;   On  = it is given the read of depth, motion vectors and the HUD-less frame as soon as they
+;         are sent, so it reads them while the game is still finishing the frame; after Present
+;         only the finished frame is left to read (recommended).
+;   Off = all reads are queued at Present, as before (for A/B).
+; Read every ~60 frames, so it can be toggled while the game runs. Default: true
+bEarlyUnpack = 1
+
+; [FG-GPU1] FSR 4.1 upscaling on the frame-generation GPU is switched on in Upscaling.dll's
+; settings (Data\MCM\Settings\Upscaling.ini, or MCM > Upscaling): iUpscaleMethodPreference = 3.
+; The game then renders at iQualityMode's resolution with TAA off, the render-resolution scene,
+; depth and motion vectors cross PCIe, and this GPU upscales with FSR 4.1 before frame
+; generation; the UI is drawn at full resolution and composited over the result. Needs
+; iFSRRuntime = 1, bAsyncUnpack = 1 and the Upscaling.dll shipped with FG-GPU1. In that mode
+; bSendHudlessFrame and iHalfResDepthMV are ignored (the scene is always sent, at full render
+; resolution). Changing the method or the quality mode needs a restart.
+
+; [FG-GPU1] Send depth (and optionally motion vectors) at half resolution to save PCIe time.
+; Only the generated frames use them; real frames and the HUD-less colour stay full resolution.
+;   0 = both at full resolution (as before).
+;   1 = depth at half resolution, rebuilt to full resolution on the frame-generation GPU.
+;       FSR3 keeps using every motion vector; only its depth tests are coarser at object
+;       edges. Saves ~24 MB/frame (~2 ms) at 4K (recommended).
+;   2 = depth AND motion vectors at half resolution. FSR3 then works at half resolution, like
+;       FSR3 frame generation behind "Performance" upscaling. Saves ~47 MB/frame (~4 ms) at 4K;
+;       use it if 1 still falls short of your frame cap in CPU-heavy areas.
+; Requires restart. Default: 1
+iHalfResDepthMV = 1
