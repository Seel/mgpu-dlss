+	secondaryGPU = true;
+	REX::INFO("[FG-GPU1] interop device on \"{}\", frame generation + present on \"{}\"",
+		CrossAdapterBridge::AdapterName(a_gameAdapter), CrossAdapterBridge::AdapterName(secondary.get()));
