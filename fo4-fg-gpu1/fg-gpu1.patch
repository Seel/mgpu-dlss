+	UINT64 statMaxLag = 0;
+	UINT64 statCpuWaits = 0;
+	UINT64 statGatePending = 0;  // GateD3D11 found the copy it queues a wait for still running
+	UINT64 statGateCalls = 0;
+	LARGE_INTEGER statLastLog{};
+	LARGE_INTEGER qpcFrequency{};
+};
